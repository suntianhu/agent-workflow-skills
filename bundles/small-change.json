{
  "schema": 2,
  "name": "small-change",
  "kind": "documented-composition-not-native-executable-workflow",
  "project_mode": "determine",
  "skills": [
    "aw-project-triage",
    "aw-skill-selection",
    "aw-model-routing",
    "aw-effort-estimation",
    "aw-repository-audit",
    "aw-project-standards",
    "aw-framework-selection",
    "aw-github-reference",
    "aw-requirements-design",
    "aw-design-reference",
    "aw-design-standards",
    "aw-ui-design",
    "aw-api-contracts",
    "aw-security-boundaries",
    "aw-test-strategy",
    "aw-scoped-tdd",
    "aw-frontend-implementation",
    "aw-backend-implementation",
    "aw-adversarial-review",
    "aw-evidence-verification",
    "aw-delivery-cleanup"
  ],
  "optional": [
    "aw-agent-coordination"
  ],
  "stages": [
    {
      "id": "triage",
      "when": "always",
      "skills": [
        "aw-project-triage"
      ],
      "note": "微小代码量不改变项目类型；新项目先走本组合的新项目条件分支，纯文档跳过代码门禁。"
    },
    {
      "id": "resources",
      "when": "as-needed",
      "skills": [
        "aw-skill-selection",
        "aw-model-routing",
        "aw-effort-estimation"
      ],
      "note": "简单任务仅做必要判断，不强制额外模型或代理。"
    },
    {
      "id": "repository-audit",
      "when": "existing-baseline-needed",
      "skills": [
        "aw-repository-audit"
      ],
      "note": ""
    },
    {
      "id": "project-standards",
      "when": "existing-baseline-needed",
      "skills": [
        "aw-project-standards"
      ],
      "note": ""
    },
    {
      "id": "framework-choice",
      "when": "new-project",
      "skills": [
        "aw-framework-selection"
      ],
      "note": ""
    },
    {
      "id": "reference-conventions",
      "when": "new-project",
      "skills": [
        "aw-github-reference"
      ],
      "note": ""
    },
    {
      "id": "new-standards",
      "when": "new-project",
      "skills": [
        "aw-project-standards"
      ],
      "note": ""
    },
    {
      "id": "requirements",
      "when": "behavior-requirements-needed",
      "skills": [
        "aw-requirements-design"
      ],
      "note": ""
    },
    {
      "id": "design-reference",
      "when": "design-reference-needed",
      "skills": [
        "aw-design-reference"
      ],
      "note": "沿用项目规范和已选平台；已有适用依据时复用，不重复调研。"
    },
    {
      "id": "design-standards",
      "when": "design-standards-needed",
      "skills": [
        "aw-design-standards"
      ],
      "note": "写回同一项目规范入口；单页局部调整不重建体系。"
    },
    {
      "id": "ui-design",
      "when": "ui-change",
      "skills": [
        "aw-ui-design"
      ],
      "note": ""
    },
    {
      "id": "contracts",
      "when": "contract-change",
      "skills": [
        "aw-api-contracts"
      ],
      "note": ""
    },
    {
      "id": "security-design",
      "when": "trust-boundary-change",
      "skills": [
        "aw-security-boundaries"
      ],
      "note": ""
    },
    {
      "id": "validation-plan",
      "when": "before-code-or-behavior-checks",
      "skills": [
        "aw-test-strategy"
      ],
      "note": "先决定TDD及保留；P0不擅自恢复。"
    },
    {
      "id": "tdd-implementation",
      "when": "tdd-selected",
      "skills": [
        "aw-scoped-tdd"
      ],
      "note": "以TDD技能统筹红绿循环，并在循环内读取implementation_constraints；完成后跳过独立实现阶段，只补未覆盖约束。",
      "implementation_constraints": [
        "aw-frontend-implementation",
        "aw-backend-implementation"
      ]
    },
    {
      "id": "implementation",
      "when": "implementation-without-tdd",
      "skills": [
        "aw-frontend-implementation",
        "aw-backend-implementation"
      ],
      "note": "只执行受影响端；已选TDD时本阶段并入TDD循环，不作为第二次实现。"
    },
    {
      "id": "review",
      "when": "nontrivial-change",
      "skills": [
        "aw-adversarial-review"
      ],
      "note": ""
    },
    {
      "id": "verify-deliver",
      "when": "always",
      "skills": [
        "aw-evidence-verification",
        "aw-delivery-cleanup"
      ],
      "note": ""
    }
  ],
  "conditions": {
    "always": "适用任务的必要判断。",
    "as-needed": "判断确有收益才加载该能力；小任务可内联判断。",
    "existing-baseline-needed": "本次要求老项目正式代码/配置/工程脚本实施，且本轮全仓阅读/内部规范尚未有效完成；仅需求、页面稿或独立展示原型跳过，不冒称开发门禁已过。",
    "behavior-requirements-needed": "新增/改变行为或验收尚不清楚；明确文案微调不额外写设计。",
    "ui-change": "本次涉及实际界面的视觉/交互设计；轻微改动沿用现有规则，纯 API/服务任务跳过。",
    "contract-change": "接口/字段/数据/调用方契约改变。",
    "trust-boundary-change": "本次涉及认证、授权、归属、私有数据/文件或其他实际信任边界。",
    "before-code-or-behavior-checks": "任何代码实现或行为检查前选定本次验证策略。",
    "tdd-selected": "本次要求正式产品代码实施，并明确选择及授权TDD；循环内使用受影响端实现约束。独立原型的显式TDD仍在UI阶段按原型范围执行，不进入本产品实现阶段。",
    "nontrivial-change": "常规/关键变更；轻微只核对需求/diff。",
    "implementation-without-tdd": "本次要求正式产品代码实施且未选择TDD；仅执行受影响端。独立展示原型在UI阶段制作，不因此进入产品实现。",
    "new-project": "本次要求真正新产品工程实施；用户选定框架前不初始化。仅需求、页面稿或独立展示原型跳过选栈/范本/工程规范阶段。",
    "design-reference-needed": "本次有界面且用户要求参考/借鉴，或方向、平台规范、具体设计问题仍需外部依据；已有足够依据不重复搜索。",
    "design-standards-needed": "用户明确要求项目级共用设计规范，或正式产品实施需要建立/改变共用规则；单独页面稿/原型缺规范时只补本页规则，不启动整套体系。"
  },
  "execution": "按阶段与条件选择，不是自动引擎；resources/审查/协作不因清单存在而强制启动。TDD是实现阶段的顺序，不是实现后的补测。 先按交付物选范围：仅需求/页面稿/独立展示原型在相应产物处停止，不机械执行产品门禁和实现；编写可运行原型代码/执行自动交互前先承接同一次局部验证决定。"
}
